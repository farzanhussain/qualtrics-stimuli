# Copy to .env and fill in.

# Cookie string copied from a logged-in RedNote browser session.
# Use a throwaway account, not her main one.
XHS_COOKIE=

# Where the built static site is written before deploy.
DIST_DIR=./dist

# Path to a local clone of the public site repo (separate from this one).
# scripts/deploy.sh syncs DIST_DIR into here and pushes.
SITE_REPO_DIR=../rednote-kb-site

# Optional: User-Agent override for scraping (default mimics desktop Chrome).
XHS_USER_AGENT=
